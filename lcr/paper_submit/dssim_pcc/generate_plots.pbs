set -eo pipefail

module load conda
conda activate my-npl-2023a
set -u

: "${DSSIM_PCC_DIR:?DSSIM_PCC_DIR was not supplied by the launcher}"
: "${DSSIM_PCC_RUN_DIR:?DSSIM_PCC_RUN_DIR was not supplied by the launcher}"

export HDF5_PLUGIN_PATH=/glade/work/haiyingx/H5Z-ZFP-PLUGIN-unbiased/plugin
export MPLBACKEND=Agg

"$DSSIM_PCC_DIR/generate_plots.sh" "$DSSIM_PCC_RUN_DIR"

